# IntelliFill Extension v2 - Environment Variables
# Copy to .env for local development

# API endpoint for development (overrides production default)
WXT_API_URL=http://localhost:3002/api

# Chrome Web Store submission (optional, for CI/CD)
# CHROME_EXTENSION_ID=
# CHROME_CLIENT_ID=
# CHROME_CLIENT_SECRET=
# CHROME_REFRESH_TOKEN=
